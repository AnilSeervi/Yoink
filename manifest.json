{
  "manifest_version": 3,
  "name": "Yoink",
  "version": "0.1.0",
  "description": "Copy a GitHub PR or issue as a rich link — title and number as the link text, with a markdown fallback for plain-text pastes.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["offscreen", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "copy-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Copy current PR/issue as a link"
    }
  }
}
